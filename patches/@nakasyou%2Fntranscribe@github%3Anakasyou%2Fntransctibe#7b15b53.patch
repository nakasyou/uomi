diff --git a/src/http-error.ts b/src/http-error.ts
new file mode 100644
index 0000000000000000000000000000000000000000..58cb99a0ee9db065dde2443771f81caaf25e9fbb
--- /dev/null
+++ b/src/http-error.ts
@@ -0,0 +1,45 @@
+/** Keep provider failures actionable without retaining credentials or large HTML responses. */
+function redact(value: string): string {
+  return value
+    .replace(/https?:\/\/[^\s<>"']+/gi, (url) => { try { const parsed = new URL(url); return parsed.origin + parsed.pathname } catch { return '[redacted-url]' } })
+    .replace(/\bBearer\s+[^\s"'<>]+/gi, 'Bearer [redacted]')
+    .replace(/\b(?:AIza[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{6,})\b/g, '[redacted]')
+    .replace(/((?:["']?)(?:api[_-]?key|access[_-]?token|refresh[_-]?token|token|authorization|secret)["']?\s*[:=]\s*)(?:"[^"]*"|'[^']*'|[^\s,;]+)/gi, '$1[redacted]')
+    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, ' ')
+    .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, ' ')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/[\x00-\x1f\x7f\s]+/g, ' ')
+    .trim()
+}
+export async function httpErrorDetail(response: Response): Promise<string> {
+  const parts: string[] = []
+  const requestId = response.headers.get('x-request-id') ?? response.headers.get('x-goog-request-id') ?? response.headers.get('cf-ray')
+  if (requestId) parts.push(`request_id=${redact(requestId).slice(0, 160)}`)
+  const reader = response.body?.getReader()
+  if (reader) {
+    const chunks: Uint8Array[] = []; let size = 0
+    try {
+      while (size < 8192) {
+        const next = await reader.read(); if (next.done) break
+        const bytes = next.value.subarray(0, 8192 - size); chunks.push(bytes); size += bytes.length
+      }
+      const raw = Buffer.concat(chunks).toString('utf8')
+      let detail = raw
+      try {
+        const data = JSON.parse(raw), error = data.error ?? data
+        detail = [error.code, error.status, error.type, typeof error === 'string' ? error : error.message].filter((v) => typeof v === 'string' || typeof v === 'number').join(': ')
+      } catch { /* HTML/plain-text errors are sanitized below. */ }
+      if (detail) parts.push(redact(detail).slice(0, 1000))
+    } catch (error) {
+      parts.push(`error response read failed: ${redact(error instanceof Error ? error.message : String(error)).slice(0, 200)}`)
+    } finally {
+      await reader.cancel().catch(() => { /* The original HTTP failure is retained. */ })
+    }
+  }
+  return parts.length ? `; ${parts.join('; ')}` : ''
+}
+export async function providerHttpError(response: Response, phase: string) {
+  return Object.assign(new Error(`${phase} HTTP ${response.status}${await httpErrorDetail(response)}`), {
+    status: response.status, retryAfter: response.headers.get('retry-after'),
+  })
+}
