{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uomi",
  "version": "0.1.0",
  "identifier": "me.uomi.client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Uomi",
        "width": 1180,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#f8faf6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "linux": {
      "deb": { "depends": ["bluez", "network-manager", "libsecret-tools"] }
    }
  }
}
