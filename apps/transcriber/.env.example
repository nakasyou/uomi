UOMI_API_URL=https://your-uomi-web.example
UOMI_CLIENT_SECRET=replace-with-the-same-client-secret-as-the-web-api
# SITES_ACCESS_TOKEN=private-sites-dispatch-token-if-required
TRANSCRIBER_PROVIDER=chrome-recognition
TRANSCRIBER_CONCURRENCY=2
TRANSCRIBER_SPLIT_SECONDS=600
TRANSCRIBER_POLL_SECONDS=5
LANGUAGE=ja
HOST=127.0.0.1
PORT=8787
REQUEST_WAIT_SECONDS=10
# TRANSCRIBER_WORKER_ID=mac-mini
# TRANSCRIBER_STATE_DIR=/absolute/path/to/private/state
# CODEX_HOME=/absolute/path/to/codex-home

# Use the same UOMI_WEBHOOK_SECRET in Sites runtime secrets.
# Sites: TRANSCRIBER_WEBHOOK_URL=https://your-daemon.example/webhook
# Optional only for legacy operation; configure both for automatic D1 refresh.
SITES_URL=https://uomi-transcript-search.nakasyou.chatgpt.site
SITES_ACCESS_TOKEN=copy-the-private-site-service-token
